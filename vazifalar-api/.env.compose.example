# .env.compose.example — Compose uchun sirlar (33-qism). Nusxa: cp .env.compose.example .env && chmod 600 .env — keyin har qiymatni YANGI tasodifiy qiling:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
# Bu faylda haqiqiy qiymat YO'Q. .env — git'da EMAS (.gitignore), image'ga tushmaydi (.dockerignore).
POSTGRES_PAROL=
API_DB_PAROL=
AUTH_DB_PAROL=
ISHCHI_DB_PAROL=
REDIS_PAROL=
# ilova (src/config.ts): >= 32 belgi
ILOVA_SIRI=
CORS_ORIGINS=https://vazifalar.lokal
ILOVA_URL=https://vazifalar.lokal
API_URL=https://vazifalar.lokal
COOKIE_SECURE=true
HSTS=true
LOG_LEVEL=info
