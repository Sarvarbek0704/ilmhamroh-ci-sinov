# /etc/sudoers.d/90-deploy — 33-qism #03/#16: deploy foydalanuvchisi uchun MINIMAL ruxsat ro'yxati (bosh muharrir qarori, 2026-11-06).
# Faqat darslarda kerak bo'lgan aniq buyruqlar; argumentlar to'liq yozilgan (boshqa xizmat nomi bilan ishlamaydi). Tekshirish: visudo -cf <fayl>
# ANTI-NAQSH: `deploy ALL=(ALL) NOPASSWD:ALL` — kalit o'g'irlansa butun server.
# 34 #01 (33 pilot qarori 2): `systemctl status …` OLIB TASHLANDI — status sudo'siz ishlaydi, root nomidagi pager (less) esa `!sh` bilan
#   root shell beradi (imtiyoz oshirish; sudo hujjati, "SECURITY NOTES"). Sudo bilan status kerak bo'lsa — `SYSTEMD_PAGER=cat` emas, ro'yxatga kiritmaslik.
Cmnd_Alias VAZIFALAR_XIZMAT = /usr/bin/systemctl restart vazifalar-api, /usr/bin/systemctl reload vazifalar-api, \
                              /usr/bin/systemctl restart vazifalar-ishchi, /usr/bin/systemctl start vazifalar-zaxira.service
Cmnd_Alias VAZIFALAR_NGINX = /usr/sbin/nginx -t, /usr/bin/systemctl reload nginx
deploy ALL=(root) NOPASSWD: VAZIFALAR_XIZMAT, VAZIFALAR_NGINX
