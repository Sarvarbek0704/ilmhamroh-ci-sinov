# Muhit o'zgaruvchilari (16/#28, #32) — namuna, Vite bu faylni O'QIMAYDI.
# Umumiy qiymatlar git'da: .env.production (npm run build) va
# .env.development (npm run dev). O'zingizniki — .env.development.local
# (git'ga kirmaydi, .gitignore: *.local) ga nusxa qilib o'zgartiring.

# Brauzer kodi so'raydigan API manzili (import.meta.env.VITE_API_URL).
# VITE_ bilan boshlangani saytga yoziladi — parol, token QO'YMANG
VITE_API_URL=/api/mashq

# Faqat npm run dev: /api/... so'rovlari qayerga uzatiladi (proxy).
# Masalan, 25-qismdagi o'z backend'ingiz:
# API_PROXY=http://localhost:3000
API_PROXY=https://ilmhamroh.uz
