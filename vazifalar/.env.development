# npm run dev (development rejimi). Brauzer API'ni o'z dev serverimizdan
# so'raydi (/api/mashq/...), Vite uni API_PROXY ga uzatadi (16/#32):
# so'rovlar terminal va DevTools'da bitta origin'da, CORS yo'q
VITE_API_URL=/api/mashq
# VITE_ siz — brauzerga CHIQMAYDI, faqat vite.config.ts o'qiydi.
# O'z backend'ingiz (25-qism): .env.development.local da
# API_PROXY=http://localhost:3000
API_PROXY=https://ilmhamroh.uz
# 19/#18: real-time (SSE) — FAQAT dev server'da (skriptlar/jonli.js).
# Production'da (Pages, Vercel) bu qiymat yo'q — kod build'ga tushmaydi
VITE_JONLI_URL=/api/jonli
# 21/#18–#19: analitika va xatolar — dev server qabul qiladi (skriptlar/
# kuzatuv.js). Production'da YO'Q: yuborilmaydi (o'z serveringiz — 25-qism)
VITE_ANALITIKA_URL=/__kuzatuv/analitika
VITE_XATO_URL=/__kuzatuv/xato
# 21/#26: AI yordamchi — dev serverdagi SOXTA oqim (skriptlar/ai-soxta.js);
# flag'i ham shu yerda yoqilgan. Production'da yo'q (kalit — faqat serverda)
VITE_AI_URL=/__ai/chat
VITE_FLAGLAR=ai-yordamchi
