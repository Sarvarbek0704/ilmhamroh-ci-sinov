{
  "name": "vazifalar",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:profil": "tsc -b && vite build --mode profil",
    "test": "vitest run --project mantiq --project komponent",
    "test:kuzat": "vitest --project mantiq --project komponent",
    "test:tarmoq": "vitest run --project tarmoq",
    "test:qamrov": "vitest run --project mantiq --project komponent --coverage",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tip": "tsc -b",
    "ikonlar": "node skriptlar/ikonlar.js",
    "check": "npm run format:check && npm run lint && npm run tip && npm test",
    "dev": "vite",
    "preview": "vite preview",
    "analiz": "node skriptlar/analiz.js",
    "prepare": "husky",
    "knip": "knip",
    "kirill": "node skriptlar/kirill.js",
    "test:brauzer": "vitest run --project brauzer",
    "test:e2e": "playwright test --project=chrome --grep-invert @karantin",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:vizual": "playwright test --project=vizual",
    "test:karantin": "playwright test --project=chrome --grep @karantin --retries=3 --pass-with-no-tests"
  },
